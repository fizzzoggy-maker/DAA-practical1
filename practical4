#include <iostream>
#include <chrono>

using namespace std;
using namespace chrono;

// Iterative Factorial Function
long long iterativeFactorial(int n)
{
    long long fact = 1;
    for (int i = 2; i <= n; i++)
    {
        fact *= i;
    }
    return fact;

}
// Recursive Factorial Function
long long recursiveFactorial(int n)
{
    if (n == 0 || n == 1)
        return 1;
    return n * recursiveFactorial(n - 1);

}

int main()
{
    int n;
    cout << "Enter a number: ";
    cin >> n;

    // Iterative Method Timing
    auto start1 = high_resolution_clock::now();
    long long result1 = iterativeFactorial(n);
    auto end1 = high_resolution_clock::now();
    cout << "\n----- Iterative Method -----\n";
    cout << "Factorial = " << result1 << endl;
    cout << "Execution Time : "
         << duration_cast<microseconds>(end1 - start1).count()
         << " microseconds" << endl;

    // Recursive Method Timing
    auto start2 = high_resolution_clock::now();
    long long result2 = recursiveFactorial(n);
    auto end2 = high_resolution_clock::now();
    cout << "\n----- Recursive Method -----\n";
    cout << "Factorial = " << result2 << endl;
    cout << "Execution Time : "
         << duration_cast<microseconds>(end2 - start2).count()
         << " microseconds" << endl;

    return 0;

}